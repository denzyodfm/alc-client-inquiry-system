DATABASE_URL="mysql://alc_user:strong_password@localhost:3306/alc_central"
# Required in production; must be at least 32 characters. The app refuses to start otherwise.
SESSION_SECRET="replace-with-at-least-32-random-characters"
# Set to true wherever the app is served over HTTPS, so the session cookie is never sent over
# a plain HTTP connection.
SESSION_COOKIE_SECURE="true"
SYNC_ENCRYPTION_KEY="replace-with-32-byte-key-material"
SYNC_BATCH_SIZE="500"
SQLSERVER_ENCRYPT="false"
SQLSERVER_TRUST_CERT="true"
NEXT_PUBLIC_APP_NAME="ALC Client Inquiry System"
# Persistent pin geocoding is disabled until an approved provider adapter is configured.
GEOCODING_PROVIDER="disabled"
# GEOCODING_API_KEY=""
# GEOCODING_BASE_URL=""
# GEOCODING_TIMEOUT_MS="10000"
# Runs the saved loan-to-location-masterlist linker daily at 1:00 AM local server time.
LOCATION_LINK_SCHEDULER_ENABLED="true"
# Optional absolute path. Defaults to <app>/logs/location-link.log.
# LOCATION_LINK_LOG_FILE="/var/log/alc/location-link.log"
